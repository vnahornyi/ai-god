#!/usr/bin/env bash
# Gates for public commits: nothing from the local overlay may enter the public tree, and the skills
# keep the repo's mechanical rules (AGENTS.md → Before staging). lint-skills reads the working tree.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/bin/check-public" --staged
"$root/bin/lint-skills"
